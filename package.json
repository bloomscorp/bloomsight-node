{
  "name": "@bloomscorp/bloomsight-node",
  "version": "0.2.0",
  "description": "Send Bloomsight email templates from your Node.js backend, safely: idempotent, retried, typed.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:package": "node scripts/verify-package.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "bloomsight",
    "bloomscorp",
    "email",
    "transactional-email",
    "templates",
    "node"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Bloomscorp",
  "homepage": "https://github.com/bloomscorp/bloomsight-node",
  "repository": {
    "type": "git",
    "url": "https://github.com/bloomscorp/bloomsight-node"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
